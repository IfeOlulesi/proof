{
  "source": "https://learn.chatgpt.com/docs/hooks (read 2026-11-03): common fields session_id, transcript_path, cwd, hook_event_name, model, permission_mode; turn-scoped events add turn_id; PreToolUse rewrite: permissionDecision \"allow\" with updatedInput.command",
  "kind": "beforeTool",
  "input": {
    "session_id": "c1",
    "transcript_path": null,
    "cwd": "/repo",
    "model": "gpt-5.5-codex",
    "permission_mode": "default",
    "hook_event_name": "PreToolUse",
    "turn_id": "t1",
    "tool_name": "Bash",
    "tool_use_id": "call_2",
    "tool_input": {
      "command": "npx vitest run"
    }
  },
  "event": {
    "tool": {
      "name": "shell",
      "raw": "Bash",
      "input": {
        "command": "npx vitest run"
      },
      "id": "call_2"
    }
  },
  "result": {
    "updatedCommand": "'node' 'guard.mjs' -- 'npx vitest run'",
    "context": "proof memory: capped at 2 workers"
  },
  "output": {
    "stdout": {
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "allow",
        "updatedInput": {
          "command": "'node' 'guard.mjs' -- 'npx vitest run'"
        },
        "additionalContext": "proof memory: capped at 2 workers"
      }
    }
  }
}
